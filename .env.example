# MKK KAP test API credentials. Keep this file private and never commit it.
MKK_USERNAME=
MKK_PASSWORD=
MKK_BASE_URL=https://apigwdev.mkk.com.tr/api/vyk

# Production source (recommended): no MKK credentials are needed.
KAP_SOURCE=public
# On first run, use the current KAP disclosure ID so old notices are not replayed.
PUBLIC_INITIAL_INDEX=

# Polling and storage
POLL_INTERVAL_SECONDS=60
DATABASE_PATH=data/kap_bot.sqlite3
# On first run, "latest" seeds the cursor without sending old test disclosures.
# Set an integer to replay from that disclosure index during testing.
INITIAL_CURSOR=latest

# Telegram notifications (optional for local dry-run; required for delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI drafting (optional; without it a deterministic Turkish draft is generated)
# Any OpenAI-compatible Responses API endpoint is supported.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# X: only circuit-breaker notices are automatically posted when set to true.
X_AUTO_POST_DKB=false
# Yahoo Finance quote data can be delayed. Before this Istanbul time, DKBs
# are posted to X as text-only; afterwards the branded card is attached.
X_DKB_VISUAL_START_TIME=10:20
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Preferred: OAuth 2.0 user token. The access token lasts two hours and the
# refresh token is automatically rotated and saved to this private .env file.
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
X_OAUTH2_ACCESS_TOKEN=
X_OAUTH2_REFRESH_TOKEN=
# Must exactly match the callback set in the X Developer Portal.
X_OAUTH2_REDIRECT_URI=http://127.0.0.1:8787/callback
